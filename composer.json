{
    "name": "mi-empresa/mi-empresa.com",
    "type": "project",
    "license": "MIT",
    "description": "The website mi-empresa.com",
    "keywords": [
        "framework",
        "laravel"
    ],
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/mi-empresa/event.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/mi-empresa/communications.git"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-apcu": "*",
        "ext-exif": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-redis": "*",
        "appstract/laravel-opcache": "^4.0",
        "barryvdh/laravel-dompdf": "^0.9.0",
        "cartalyst/stripe-laravel": "^13.0",
        "dipeshsukhia/laravel-html-minify": "^1.1",
        "doctrine/annotations": "^1.13",
        "doctrine/dbal": "^3.3",
        "fideloper/proxy": "^4.2",
        "fruitcake/laravel-cors": "^2.0",
        "google/apiclient": "^2.9",
        "guzzlehttp/guzzle": "^7.0.1",
        "guzzlehttp/psr7": "^1.8",
        "laravel-doctrine/orm": "*",
        "laravel/framework": "^8.0",
        "laravel/helpers": "^1.2",
        "laravel/legacy-factories": "^1.1",
        "laravel/socialite": "^5.0",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^3.0",
        "league/flysystem-aws-s3-v3": "^1.0",
        "mi-empresa/event": "^1.0",
        "mesavolt/mdi-php": "^1.1",
        "mnsami/composer-custom-directory-installer": "^2.0",
        "predis/predis": "^1.1",
        "sentry/sentry-laravel": "^2.6",
        "spatie/laravel-feed": "^3.0",
        "spatie/laravel-google-calendar": "^3.3",
        "spatie/laravel-mix-preload": "^1.2",
        "spatie/laravel-query-builder": "^3.3",
        "stripe/stripe-php": "^7.32",
        "symfony/dependency-injection": "^6.0",
        "symfony/stopwatch": "^6.0",
        "web-token/jwt-core": "^2.2",
        "web-token/jwt-encryption": "^2.2",
        "web-token/jwt-encryption-algorithm-aesgcm": "^2.2",
        "web-token/jwt-encryption-algorithm-dir": "^2.2"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.6",
        "barryvdh/laravel-ide-helper": "^2.1",
        "facade/ignition": "^2.3.6",
        "fzaninotto/faker": "^1.9.1",
        "laravel/dusk": "^6.8",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^9.0",
        "squizlabs/php_codesniffer": "^3.6"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": {
            "mi-empresa/*": "source",
            "*": "dist"
        },
        "sort-packages": true,
        "process-timeout":0
    },
    "extra": {
        "laravel": {
            "dont-discover":  [
                "barryvdh/laravel-ide-helper",
                "sentry/sentry-laravel",
                "sentry/sentry"
            ]
        },
        "installer-paths": {
            "./packages/{$vendor}/{$name}/": ["mi-empresa/event","mi-empresa/communications"]
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Mi-empresa\\": "src/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan optimize",
            "@php artisan route:cache"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate"
        ],
        "post-install-cmd": [
            "@php artisan mi-empresa:prepare-libraries"
        ],
        "run-unit-tests" : "./vendor/bin/phpunit",
        "check-style": "./vendor/bin/phpcs --runtime-set ignore_warnings_on_exit 1"
    }
}
